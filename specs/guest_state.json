 "host_registers": {
  "gpr": "x86 GPR i in x_i (i = 0..15)",
  "flags": "CF ZF SF OF in x19..x22 as 0/1; x24 one bit per undefined flag; AF and PF lazy (state block af_operands: AF is bit 4 of a ^ b ^ r, PF is set when r's low byte has an even number of ones; 0.3.0, 2026-10-14); DF in the state block",
  "xmm": "XMM i in v_i (i = 0..15)",
  "ymm_high": "upper 128 bits of YMM i in v(16+i)",
  "mxcsr": "rounding control mirrored into FPCR.RMode; FTZ and DAZ into FPCR.FZ and FPCR.FIZ where present; exception flags kept in the state block",
  "x87": "state block only",
  "scratch": "x16, x17, x18, x25-x27, x29, x30 (temporaries of one lifted instruction); x28 points at the monitor data page"
 },
 "reconstruction_table": {
  "note": "per translated block; produces a CONTEXT at any guest instruction boundary, mid-block included (v0.2 section 5)",
  "entry": {
   "host_pc_start": "u64",
   "host_pc_end": "u64, exclusive",
   "guest_rip": "u64",
   "locations": "per guest register: {'host': '<A64 register>'} or {'block': '<state block field>'}; flags: {'host': 'x19..x23', 'undefined': 'x24'} or {'block': 'rflags'}; AF from af_operands; DF from the state block"
  },
  "rule": "Two rules (review 2026-10-09 progress N2). Faults: a translated instruction commits no guest-visible effect (memory store, register write, RSP, flags) before its last possible fault point, so a fault maps to the boundary before the instruction and resuming re-executes it whole; the semantics oracle checks this with fault cases. Asynchronous stops (hv_vcpus_exit for SuspendThread, GetThreadContext, a GC stop): the vCPU runs forward to the next table boundary before the CONTEXT is built; it never maps backward, because a backward map would re-execute half-done effects (PUSH: store then RSP; ADD [m], r: load, store, flags; LOCK XADD: a reference count)"
 },
