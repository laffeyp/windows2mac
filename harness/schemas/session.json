{
  "schema_version": 1,
  "kinds": {
    "SESSION_INIT": {
      "vocab_version": {"type": "str", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
      "profile": {"type": "str", "min_length": 1},
      "contract_version": {"type": "str", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
      "harness_version": {"type": "str", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
      "purpose": {"type": "str", "enum": ["contract_construction", "conformance", "compilation", "capability", "measurement", "application", "product"]}
    },
    "SESSION_COMPLETED": {
      "outcome": {"type": "str", "enum": ["completed", "completed_with_discrepancies", "aborted"]},
      "discrepancy_count": {"type": "int", "ge": 0, "le": 9007199254740991},
      "accepted_count": {"type": "int", "ge": 0, "le": 9007199254740991},
      "elapsed_seconds": {"type": "float"}
    }
  }
}
